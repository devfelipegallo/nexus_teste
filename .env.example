PORT=3000

# Defina uma senha forte antes da primeira inicialização.
# Se ficar vazia, o terminal exibirá uma senha aleatória uma única vez.
NEXUS_ADMIN_PASSWORD=
# Use 1 somente em ambiente de demonstração para criar user/123 e visitante/abc.
NEXUS_SEED_DEMO=0

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
SPOTIFY_MARKET=BR

# O usuário do Komga é o e-mail cadastrado na configuração inicial.
KOMGA_URL=http://localhost:25600
KOMGA_USERNAME=
KOMGA_PASSWORD=
